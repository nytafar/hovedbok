# Copy to .env in the deploy checkout (mode 600). Generate every secret with
# `openssl rand -hex 32`; hex keeps the passwords URL-safe in DATABASE_URL_*.
COMPOSE_FILE=compose.prod.yml

# postgres owner (migrations run as this user)
POSTGRES_PASSWORD=

# login users, one per principal (ADR-0010; created by db/logins.ts)
HOVEDBOK_API_PASSWORD=
HOVEDBOK_READER_PASSWORD=

# bearer tokens: read-write, read-only (GET only), MCP clients
API_TOKEN=
API_RO_TOKEN=
MCP_TOKEN=

# The MCP gateway's docker network (default mcp-gateway-registry_default).
#MCP_GATEWAY_NETWORK=

# Enable Banking — leave unset until an application is registered in the
# Control Panel (README "Enable Banking"; ~/hvelv/repos/hovedbok/howto-enable-banking-consent.md).
# The bank routes answer 503 while these are unset. Put the PEM in ./secrets/
# (mounted read-only at /secrets).
#ENABLE_BANKING_APP_ID=
#ENABLE_BANKING_KEY_FILE=/secrets/enable_banking_private.pem
#ENABLE_BANKING_REDIRECT_URL=https://hovedbok.<tailnet>.ts.net/bank/consent-callback
#ENABLE_BANKING_API_URL=https://api.enablebanking.com
#PSU_IP_ADDRESS=
#PSU_USER_AGENT=
